// The Node-side tests, their helpers, and scripts/ TypeScript, type-checked and never emitted.
// See docs/development.md
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["test/**/*.ts", "scripts/**/*.ts"]
}
